<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FDFDFB">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BCA VIRTUAL ACCOUNT"
        android:textColor="#F02A87"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Nomor Virtual Account"
        android:textColor="#777777"
        android:gravity="center"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="123 456 7890"
        android:textColor="#222222"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Total Pembayaran"
        android:textColor="#777777"
        android:gravity="center"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvVAAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Rp0"
        android:textColor="#F02A87"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Selesaikan pembayaran sebelum"
        android:textColor="#777777"
        android:textSize="13sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvVACountdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="15:00"
        android:textColor="#F02A87"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center" />

    <Button
        android:id="@+id/btnCheckPayment"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#F02A87"
        android:text="CEK STATUS PEMBAYARAN"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCloseVA"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#EEEEEE"
        android:text="TUTUP"
        android:textColor="#333333" />

</LinearLayout>