<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FDFDFB">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="32sp"
            android:textColor="#1F1F1F" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ORDER COMPLETE"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#1F1F1F" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />

    </LinearLayout>


    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="55dp"
            android:paddingBottom="30dp">

            <!-- SUCCESS ICON -->
            <TextView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:gravity="center"
                android:background="#FCE5EF"
                android:text="✓"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="#F02A87" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Payment Successful!"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1F1F1F" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Thank you for your order. Your fashion pieces are on their way ♡"
                android:textSize="14sp"
                android:textColor="#777777"
                android:lineSpacingExtra="4dp" />


            <!-- ORDER CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#F4F4F5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ORDER NUMBER"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#888888" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="#ORC-20261005-001"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#1F1F1F" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:background="#D9D9DC" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL PAID"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#888888" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Rp 383.000"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#F02A87" />

            </LinearLayout>


            <!-- SHIPPING -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SHIPPING TO"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#888888" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Farah Amelia"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1F1F1F" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Jl. Example No. 123, Cirebon&#10;Jawa Barat • 45121"
                    android:textSize="13sp"
                    android:textColor="#777777"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- BOTTOM BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#FDFDFB">

        <Button
            android:id="@+id/btnContinueShopping"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="CONTINUE SHOPPING"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F02A87" />

        <Button
            android:id="@+id/btnViewOrder"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="VIEW MY ORDER"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1F1F1F"
            android:backgroundTint="#F1F1F3" />

    </LinearLayout>

</LinearLayout>