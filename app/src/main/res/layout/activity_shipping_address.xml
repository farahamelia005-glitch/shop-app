<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FDFDFB">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="32sp"
            android:textColor="#1F1F1F" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="SHIPPING ADDRESS"
            android:textColor="#1F1F1F"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp" />

    </LinearLayout>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <!-- PAGE TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Where should we send it?"
                android:textColor="#1F1F1F"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Add your delivery address"
                android:textColor="#888888"
                android:textSize="13sp" />

            <!-- CONTACT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="CONTACT INFORMATION"
                android:textColor="#1F1F1F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:hint="Full Name"
                android:inputType="textPersonName"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#1F1F1F"
                android:textColorHint="#999999"
                android:backgroundTint="#D9D9DC" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:hint="Phone Number"
                android:inputType="phone"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#1F1F1F"
                android:textColorHint="#999999"
                android:backgroundTint="#D9D9DC" />

            <!-- ADDRESS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="DELIVERY ADDRESS"
                android:textColor="#1F1F1F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:layout_marginTop="12dp"
                android:gravity="top"
                android:hint="Street address"
                android:inputType="textPostalAddress|textMultiLine"
                android:padding="15dp"
                android:textColor="#1F1F1F"
                android:textColorHint="#999999"
                android:backgroundTint="#D9D9DC" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etCity"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="City"
                    android:inputType="textCapWords"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColor="#1F1F1F"
                    android:textColorHint="#999999"
                    android:backgroundTint="#D9D9DC" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <EditText
                    android:id="@+id/etPostalCode"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="Postal Code"
                    android:inputType="number"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColor="#1F1F1F"
                    android:textColorHint="#999999"
                    android:backgroundTint="#D9D9DC" />

            </LinearLayout>

            <EditText
                android:id="@+id/etProvince"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:hint="Province"
                android:inputType="textCapWords"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#1F1F1F"
                android:textColorHint="#999999"
                android:backgroundTint="#D9D9DC" />

            <!-- SAVE ADDRESS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:background="#F02A87"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Save this address for next time"
                    android:textColor="#555555"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- SHIPPING METHOD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="SHIPPING METHOD"
                android:textColor="#1F1F1F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <RadioGroup
                android:id="@+id/rgShipping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbRegular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:padding="12dp"
                    android:buttonTint="#F02A87"
                    android:background="#FCE5EF"
                    android:checked="true"
                    android:text="Regular Delivery  •  2–5 business days\nRp 15.000"
                    android:textColor="#1F1F1F"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbExpress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="72dp"
                    android:padding="12dp"
                    android:buttonTint="#F02A87"
                    android:background="#FFFFFF"
                    android:text="Express Delivery  •  1–2 business days\nRp 30.000"
                    android:textColor="#1F1F1F"
                    android:textSize="13sp" />

            </RadioGroup>

            <!-- CONTINUE -->
            <Button
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:backgroundTint="#F02A87"
                android:text="CONTINUE TO CHECKOUT"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>